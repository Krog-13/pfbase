# Copy to .env in the project root and replace all replace-with-* values.
# This example contains placeholders, not working credentials.

# Django: generate a unique secret key for each environment.
SECRET_KEY=replace-with-a-unique-random-django-secret-key-at-least-50-characters-long
DEBUG=False
# LOCAL=True allows every CORS origin; keep False for an explicit origin list.
LOCAL=False
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL when Django runs on the host (example Compose publishes port 5424).
# Match the database, user and password configured for your PostgreSQL instance.
# When Django runs in Compose, use DATABASE_HOST=pgdb and DATABASE_PORT=5432.
DATABASE_NAME=report
DATABASE_USER=kmg_user
DATABASE_PASSWORD=replace-with-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5424

# SMTP for password reset emails. Use either TLS on 587 or SSL on 465, not both.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# MinIO / S3-compatible storage. Endpoint must include http:// or https://.
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=templates

# Comma-separated values without spaces. Origins include the scheme and port.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5174,http://127.0.0.1:5174

# Trusted backend origin used to build password reset links (no /api suffix).
# An empty value uses the validated request host instead.
PASSWORD_RESET_BASE_URL=http://localhost:8000

# Account security: all durations below are in seconds.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_SECONDS=900
AUTH_PASSWORD_MAX_AGE=7776000
AUTH_ACCESS_SECONDS=900
AUTH_SESSION_MAX_AGE=28800
AUTH_IDLE_SECONDS=1800
AUTH_RESET_SECONDS=1800
PASSWORD_MIN_LENGTH=12
